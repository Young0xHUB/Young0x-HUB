local function updateToggle()
    if State.antiLag then
        Toggle.BackgroundColor3 = Color3.fromRGB(46, 190, 120)
        Knob.Position = UDim2.fromOffset(25, 3)
    else
        Toggle.BackgroundColor3 = Color3.fromRGB(55, 62, 76)
        Knob.Position = UDim2.fromOffset(3, 3)
    end
end

Toggle.MouseButton1Click:Connect(function()
    setAntiLag(not State.antiLag)
    updateToggle()
end)

local dragging = false
local dragInput = nil
local dragStart = nil
local startPosition = nil
local moved = false

Main.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        moved = false
        dragStart = input.Position
        startPosition = Main.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

Main.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input == dragInput and dragStart and startPosition then
        local delta = input.Position - dragStart
        if delta.Magnitude > 3 then
            moved = true
        end

        Main.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

function Controller.Set(enabled)
    setAntiLag(enabled)
    updateToggle()
end

function Controller.Destroy(restore)
    if not State.running then
        return
    end

    if restore ~= false and State.antiLag then
        State.antiLag = false
        State.generation += 1
        local generation = State.generation

        stopThread(scanThread)
        stopThread(restoreThread)
        scanThread = nil
        restoreThread = nil

        if antiLagAddedConnection then
            antiLagAddedConnection:Disconnect()
            antiLagAddedConnection = nil
        end

        pcall(function()
            restoreAntiLag(generation)
        end)
    end

    State.running = false

    if antiLagAddedConnection then
        antiLagAddedConnection:Disconnect()
        antiLagAddedConnection = nil
    end

    stopThread(scanThread)
    stopThread(restoreThread)

    if Gui then
        Gui:Destroy()
    end

    if Env.Young0xAntiLagStandalone == Controller then
        Env.Young0xAntiLagStandalone = nil
    end
end

updateToggle()
